# Clave para firmar los JWT (usa un valor largo y aleatorio en produccion)
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Base de datos: si DATABASE_URL tiene valor, se ignoran las variables MYSQL_*
# Ejemplo SQLite para desarrollo rapido: DATABASE_URL=sqlite:///./microcrm.db
DATABASE_URL=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=microcrm_db

# Crear las tablas que falten al iniciar la API
AUTO_CREATE_TABLES=true
# Mostrar el SQL generado en consola
DB_ECHO=false
# Marcar tareas vencidas como 'overdue' cada hora
ENABLE_SCHEDULER=true

# Origenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Limites de peticiones por minuto
RATE_LIMIT_AUTH_PER_MIN=5
RATE_LIMIT_API_PER_MIN=60
